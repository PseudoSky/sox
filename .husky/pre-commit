#!/usr/bin/env sh
# .husky/pre-commit — canonical pre-commit hook source.
#
# This file is not wired up by a `core.hooksPath` or a husky npm package —
# there is no `prepare` script and `husky` is not a devDependency (verified
# 2026-08-01, BL-359). It is installed into `.git/hooks/pre-commit` by
# `node tools/install-git-hooks.mjs`, which every clone/worktree must run
# once (hooks are never tracked by git). Edit THIS file, not the copy under
# `.git/hooks/` — re-run the installer after editing to pick up changes.

set -e

# BL-457 — refuse a pathspec-less `git commit --amend` while the shared index diverges from HEAD.
# `--amend` reads as a message-only operation but commits the SHARED INDEX; one live incident turned
# a reviewed 2-file/+282 commit into 8 files/+727/-2567, hidden behind an already-approved subject.
# git gives hooks no signal for --amend (the environment is byte-identical to a normal commit,
# measured on git 2.51), so the parent command line is passed in explicitly.
SOX_GIT_PARENT_CMD="$(ps -o args= -p $PPID 2>/dev/null)" node tools/check-amend-shared-index.mjs

# BL-359 — reject BL-<n> id collisions before they reach BACKLOG.md/CHANGELOG.md.
node tools/check-bl-id-integrity.mjs

# Keep the memory-program plan honest: PLAN.md's packet ledger and STATE.md's progress summary are
# DERIVED from BACKLOG.md's heading markers. Closing an item without regenerating them leaves two
# documents that read as authoritative while being wrong — the exact failure this guard exists to
# stop (PLAN.md once named 39 already-closed ids). Only fires when BACKLOG.md is part of the commit;
# a change elsewhere cannot invalidate the derived blocks.
if git diff --cached --name-only | grep -qx 'BACKLOG.md'; then
  node tools/plan-status.mjs --check
fi

npx nx affected --target=lint --base=HEAD~1 --head=HEAD
