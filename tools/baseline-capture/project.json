{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "baseline-capture",
  "projectType": "library",
  "root": "tools/baseline-capture",
  "sourceRoot": "tools/baseline-capture/src",
  "tags": [
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "@adhd/sox-nx:atomic-tsc",
      "outputs": [
        "{workspaceRoot}/tools/baseline-capture/dist"
      ],
      "options": {
        "main": "tools/baseline-capture/src/index.ts",
        "outputPath": "tools/baseline-capture/dist",
        "tsConfig": "tools/baseline-capture/tsconfig.json",
        "assets": [],
        "clean": true,
        "rootDir": "tools/baseline-capture/src"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config tools/baseline-capture/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "tools/baseline-capture/**/*.ts"
        ]
      }
    },
    "capture-enrichment-baseline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/baseline-capture/dist/capture-enrichment-baseline.js",
        "cwd": "."
      },
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "capture-write-perf-baseline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/baseline-capture/dist/capture-write-perf-baseline.js",
        "cwd": "."
      },
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
