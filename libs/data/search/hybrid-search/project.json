{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "hybrid-search",
  "projectType": "library",
  "root": "libs/data/search/hybrid-search",
  "sourceRoot": "libs/data/search/hybrid-search/src",
  "tags": [
    "type:lib",
    "area:data",
    "group:search"
  ],
  "targets": {
    "build": {
      "executor": "@adhd/sox-nx:atomic-tsc",
      "outputs": [
        "{workspaceRoot}/libs/data/search/hybrid-search/dist"
      ],
      "options": {
        "main": "libs/data/search/hybrid-search/src/index.ts",
        "outputPath": "libs/data/search/hybrid-search/dist",
        "tsConfig": "libs/data/search/hybrid-search/tsconfig.lib.json",
        "assets": [],
        "clean": true,
        "rootDir": "libs/data/search/hybrid-search/src"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/data/search/hybrid-search/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "dependsOn": [
        "^build",
        "build"
      ],
      "inputs": [
        "default",
        "^production"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/data/search/hybrid-search/tsconfig.json --noEmit",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/data/search/hybrid-search/**/*.ts"
        ]
      }
    }
  }
}
