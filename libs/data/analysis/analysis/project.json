{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "analysis",
  "projectType": "library",
  "root": "libs/data/analysis/analysis",
  "sourceRoot": "libs/data/analysis/analysis/src",
  "tags": [
    "type:lib",
    "area:data",
    "group:analysis"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/libs/data/analysis/analysis/dist"
      ],
      "options": {
        "main": "libs/data/analysis/analysis/src/index.ts",
        "outputPath": "libs/data/analysis/analysis/dist",
        "tsConfig": "libs/data/analysis/analysis/tsconfig.lib.json",
        "assets": [],
        "clean": true
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/data/analysis/analysis/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/data/analysis/analysis/**/*.ts"
        ]
      }
    }
  }
}