{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "manifest",
  "projectType": "library",
  "root": "libs/manifest",
  "sourceRoot": "libs/manifest/src",
  "tags": ["type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/manifest/dist"],
      "options": {
        "command": "tsc --project libs/manifest/tsconfig.lib.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/schema.json",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/manifest/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.ts", "{projectRoot}/src/schema.json"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/manifest/**/*.ts"]
      }
    }
  }
}
