{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "manifest",
  "projectType": "library",
  "root": "libs/manifest",
  "sourceRoot": "libs/manifest/src",
  "tags": ["type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/manifest/dist"],
      "options": {
        "command": "tsc --project libs/manifest/tsconfig.lib.json && echo '{\"type\":\"commonjs\"}' > libs/manifest/dist/package.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/schema.json",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/manifest/vitest.config.ts"
      },
      "cache": true,
      "dependsOn": ["test-scripts"],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/src/schema.json",
        "{projectRoot}/vitest.config.ts"
      ]
    },
    "test-scripts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run scripts/validate-manifests.test.ts"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/validate-manifests.ts",
        "{workspaceRoot}/scripts/validate-manifests.test.ts",
        "{workspaceRoot}/extensions/**/*",
        "{workspaceRoot}/registry/index.json"
      ]
    },
    "check-registry": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/check-registry-sync.ts"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/check-registry-sync.ts",
        "{workspaceRoot}/scripts/build-index.ts",
        "{workspaceRoot}/extensions/**/*",
        "{workspaceRoot}/registry/index.json"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/manifest/**/*.ts"]
      }
    }
  }
}
