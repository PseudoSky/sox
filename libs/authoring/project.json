{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "authoring",
  "projectType": "library",
  "root": "libs/authoring",
  "sourceRoot": "libs/authoring/src",
  "tags": [
    "type:lib",
    "area:platform",
    "group:authoring"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/libs/authoring/dist"
      ],
      "options": {
        "command": "tsc --project libs/authoring/tsconfig.lib.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/authoring/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/authoring/**/*.ts"
        ]
      }
    }
  }
}
