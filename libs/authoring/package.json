{
  "name": "@adhd/sox-authoring",
  "version": "0.2.1",
  "description": "Pure scaffold core — scaffold(opts) → FileSet (no @nx/devkit dependency)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
