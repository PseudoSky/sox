    "@adhd/sox-service-proxy": "workspace:^",
    "@adhd/sox-telemetry": "workspace:^"
  },
  "keywords": [
    "mcp",
    "runtime",
    "stdio",
    "sse",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git"
  },
  "homepage": "https://github.com/PseudoSky/adhd"
