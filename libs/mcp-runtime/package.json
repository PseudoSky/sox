{
  "name": "@adhd/sox-mcp-runtime",
  "version": "0.3.2",
  "description": "Sox MCP runtime wrapper — uniform C6 enforcement across stdio + sse transports",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
