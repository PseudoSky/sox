{
  "name": "@adhd/sox-listen-guard",
  "version": "0.1.0",
  "description": "Repo-wide listen() safety invariant — probe-before-bind + guarded listen + structured JSONL failure records (BL-619). Dependency-free leaf (node builtins only).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "listen",
    "socket",
    "singleton",
    "eaddrinuse",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git"
  },
  "homepage": "https://github.com/PseudoSky/adhd"
}
