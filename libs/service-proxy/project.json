{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "service-proxy",
  "projectType": "library",
  "root": "libs/service-proxy",
  "sourceRoot": "libs/service-proxy/src",
  "tags": [
    "type:lib",
    "area:platform",
    "group:runtime"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/libs/service-proxy/dist"
      ],
      "options": {
        "main": "libs/service-proxy/src/index.ts",
        "outputPath": "libs/service-proxy/dist",
        "tsConfig": "libs/service-proxy/tsconfig.lib.json",
        "assets": [],
        "clean": true
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/service-proxy/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/service-proxy/**/*.ts"
        ]
      }
    }
  }
}