#!/usr/bin/env node
'use strict';
// One script, three commands: the mode (ro|impl|merge) is selected ONLY by
// basename(argv[1]) (sox-git-ro / sox-git-impl / sox-git-merge). No flag or env
// var can change it, so the per-agent allowlist decides capability.
let policy;
try {
  policy = require('../dist/policy.js');
} catch (err) {
  process.stderr.write('sox-git: build missing (run: npx nx build agent-shell-wrappers)\n');
  process.exit(3);
}
process.exitCode = policy.runGitCli(process.argv[1] || '', process.argv.slice(2));
