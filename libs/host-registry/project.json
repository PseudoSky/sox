{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "host-registry",
  "projectType": "library",
  "root": "libs/host-registry",
  "sourceRoot": "libs/host-registry/src",
  "tags": [
    "type:lib",
    "area:platform",
    "group:host"
  ],
  "targets": {
    "build": {
      "executor": "@adhd/sox-nx:atomic-tsc",
      "outputs": [
        "{workspaceRoot}/libs/host-registry/dist"
      ],
      "options": {
        "main": "libs/host-registry/src/index.ts",
        "outputPath": "libs/host-registry/dist",
        "tsConfig": "libs/host-registry/tsconfig.lib.json",
        "assets": [],
        "clean": true,
        "rootDir": "libs/host-registry/src"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/host-registry/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/host-registry/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/host-registry/tsconfig.json --noEmit",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    }
  }
}
