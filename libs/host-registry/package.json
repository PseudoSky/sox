{
  "name": "@adhd/sox-host-registry",
  "version": "0.5.0",
  "description": "Pluggable per-host registry: claude, codex, opencode, and agent-mcp modules with detect/scopePaths/surfaces + per-host agent renderers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "mcp",
    "host",
    "registry",
    "claude",
    "codex",
    "opencode",
    "agent-mcp",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git"
  },
  "homepage": "https://github.com/PseudoSky/adhd"
}
