{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tokenguard-core",
  "projectType": "library",
  "root": "libs/tokenguard-core",
  "sourceRoot": "libs/tokenguard-core/src",
  "tags": ["type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/tokenguard-core/dist"],
      "options": {
        "command": "tsc --project libs/tokenguard-core/tsconfig.lib.json && echo '{\"type\":\"commonjs\"}' > libs/tokenguard-core/dist/package.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/tokenguard-core/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/tokenguard-core/**/*.ts"]
      }
    }
  }
}
