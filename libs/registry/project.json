{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "registry",
  "projectType": "library",
  "root": "libs/registry",
  "sourceRoot": "libs/registry/src",
  "tags": [
    "type:lib",
    "area:platform",
    "group:distribution"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/libs/registry/dist"
      ],
      "options": {
        "command": "tsc --project libs/registry/tsconfig.lib.json && echo '{\"type\":\"commonjs\"}' > libs/registry/dist/package.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/registry/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/registry/**/*.ts"
        ]
      }
    },
    "sync-index": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/build-index.ts",
        "cwd": "."
      },
      "dependsOn": [
        {
          "projects": "*",
          "target": "build"
        }
      ],
      "outputs": [
        "{workspaceRoot}/registry/index.json"
      ],
      "cache": false
    }
  }
}
