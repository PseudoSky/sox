{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "source-provider",
  "projectType": "library",
  "root": "libs/source-provider",
  "sourceRoot": "libs/source-provider/src",
  "tags": ["type:lib", "area:data", "group:source"],
  "targets": {
    "build": {
      "executor": "@adhd/sox-nx:atomic-tsc",
      "outputs": ["{workspaceRoot}/libs/source-provider/dist"],
      "options": {
        "main": "libs/source-provider/src/index.ts",
        "outputPath": "libs/source-provider/dist",
        "tsConfig": "libs/source-provider/tsconfig.lib.json",
        "assets": [],
        "clean": true,
        "rootDir": "libs/source-provider/src"
      },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.ts", "{projectRoot}/tsconfig.lib.json"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/source-provider/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/source-provider/**/*.ts"]
      }
    }
  }
}
