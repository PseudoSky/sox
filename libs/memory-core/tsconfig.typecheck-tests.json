{
  // BL-340 — spec-inclusive typecheck. `tsconfig.typecheck.json` excludes
  // *.spec.ts / *.test.ts, so specs were never typechecked and BL-325's 18-file
  // await-drop shipped undetected.
  //
  // `include` deliberately covers src/**/*.ts, not just the spec glob: a spec
  // cannot be typechecked without also checking the modules it imports. Keeping
  // this as its own target (`typecheck-tests`, a `typecheck` dependency) rather
  // than folding it into `typecheck` is what preserves triage clarity: the nx
  // task name in a failure (`<p>:typecheck-tests` vs `<p>:typecheck`) tells you
  // whether the break is in a spec/test-support file or in production src, even
  // though `typecheck` now always runs `typecheck-tests` first as a dependency.
  //
  // module/moduleResolution differ from the lib config on purpose: vitest runs
  // these files as ESM (the chaos specs use import.meta), which CommonJS/node10
  // rejects with TS1343.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/embedWorker.ts", "node_modules"]
}
