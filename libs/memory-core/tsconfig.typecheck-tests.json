{
  // BL-340 — spec-inclusive typecheck. `tsconfig.typecheck.json` excludes
  // *.spec.ts / *.test.ts, so specs were never typechecked and BL-325's 18-file
  // await-drop shipped undetected.
  //
  // `include` deliberately covers src/**/*.ts, not just the spec glob: a spec
  // cannot be typechecked without also checking the modules it imports.
  //
  // Chain (da25489b): `typecheck` (executor `nx:noop`, no command of its own) ->
  // `typecheck-tests` (this file) -> `typecheck-src` (production-only,
  // `tsconfig.typecheck.json`). `typecheck` is just the aggregate entry point a
  // whole-repo sweep runs; the two real tsc invocations are the leaves. This is
  // what preserves triage clarity: the nx task name in a failure tells you where
  // to look —
  //   - a failure in `<p>:typecheck-src` means production code;
  //   - a failure in `<p>:typecheck-tests` means specs, test-support, or a
  //     production file that fails only under bundler resolution (e.g. the
  //     embedWorker.ts exclude below).
  //
  // module/moduleResolution differ from the lib config on purpose: vitest runs
  // these files as ESM (the chaos specs use import.meta), which CommonJS/node10
  // rejects with TS1343.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/embedWorker.ts", "node_modules"]
}
