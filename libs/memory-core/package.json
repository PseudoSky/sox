{
  "name": "@adhd/sox-memory-core",
  "version": "0.2.1",
  "description": "Shared internal library for the sox-memory subsystem (db, schema, embed, recall, write, memoryd, extensions)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@adhd/sox-embedding-provider": "workspace:*",
    "@adhd/sox-graph-store": "workspace:*",
    "@adhd/sox-hybrid-search": "workspace:*",
    "@adhd/sox-vector-store": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "fastembed": "^2.1.0",
    "sqlite-vec": "^0.1.9"
  }
}
