{
  "name": "sox-ecosystem",
  "version": "1.0.0",
  "description": "LLM extension ecosystem monorepo \u2014 agents, skills, mcp-servers, prompts, hooks, commands",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "postinstall": "pnpm rebuild better-sqlite3 sqlite-vec",
    "verify:abi": "node tools/verify-native-abi.mjs",
    "typecheck": "tsc --noEmit",
    "validate-manifests": "npx tsx scripts/validate-manifests.ts",
    "check-nx-cache": "node tools/check-nx-cache.cjs",
    "build-index": "npx tsx scripts/build-index.ts",
    "build-index:publish": "SOX_REGISTRY_PUBLISH=npm npx tsx scripts/build-index.ts",
    "check-publishable": "npx tsx scripts/check-publishable.ts",
    "install-extensions": "npx tsx scripts/install.ts",
    "routing:build-index": "npx tsx scripts/build-routing-index.ts",
    "routing:check-drift": "npx tsx scripts/check-routing-drift.ts",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "release:prepared": "npm run build-index:publish && nx build sox && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nx/devkit": "^22.7.5",
    "@nx/eslint": "^22.7.5",
    "@nx/eslint-plugin": "^22.7.5",
    "@nx/js": "^22.7.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.20",
    "@typescript-eslint/parser": "^8.61.0",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "jsonc-parser": "3.3.1",
    "nx": "^22.7.5",
    "tslib": "^2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite-vec",
      "esbuild"
    ]
  }
}
