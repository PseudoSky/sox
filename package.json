{
  "name": "sox-ecosystem",
  "version": "1.0.0",
  "description": "LLM extension ecosystem monorepo — agents, skills, mcp-servers, prompts, hooks, commands",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "postinstall": "pnpm rebuild better-sqlite3 sqlite-vec",
    "verify:abi": "node tools/verify-native-abi.mjs",
    "typecheck": "tsc --noEmit",
    "validate-manifests": "npx tsx scripts/validate-manifests.ts",
    "check-nx-cache": "node tools/check-nx-cache.cjs",
    "backlog:stats": "node tools/backlog-stats.mjs --out docs/reporting/memory/FILING-STATS.md",
    "build-index": "npx tsx scripts/build-index.ts",
    "build-index:publish": "SOX_REGISTRY_PUBLISH=npm npx tsx scripts/build-index.ts",
    "check-publishable": "npx tsx scripts/check-publishable.ts",
    "check-published-bytes": "npx tsx scripts/check-registry-sync.ts --published-bytes-only",
    "check-changeset-surface": "npx tsx scripts/check-changeset-surface.ts",
    "cascade-plan": "npx tsx scripts/cascade-plan.ts",
    "install-extensions": "npx tsx scripts/install.ts",
    "routing:build-index": "npx tsx scripts/build-routing-index.ts",
    "routing:check-drift": "npx tsx scripts/check-routing-drift.ts",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node tools/release-consumers.mjs && changeset publish",
    "release:prepared": "node tools/release-consumers.mjs && npm run build-index:publish && SOX_REGISTRY_PUBLISH=npm nx build sox && changeset publish",
    "verify:publint-attw": "node tools/verify-exports-publint-attw.mjs",
    "release:consumers": "node tools/release-consumers.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nx/devkit": "^22.7.5",
    "@nx/esbuild": "^22.7.5",
    "@nx/eslint": "^22.7.5",
    "@nx/eslint-plugin": "^22.7.5",
    "@nx/js": "^22.7.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.20",
    "@typescript-eslint/parser": "^8.61.0",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "esbuild": "^0.28.0",
    "jsonc-parser": "3.3.1",
    "nx": "^22.7.5",
    "publint": "^0.3.21",
    "tslib": "^2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.4.3",
    "@adhd/sox-graph-store": "workspace:*",
    "@adhd/sox-store-adapter": "workspace:*"
  },
  "dependencies": {
    "@tursodatabase/database": "^0.7.1",
    "better-sqlite3": "^12.10.0",
    "sqlite-vec": "^0.1.9",
    "ulid": "^3.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite-vec",
      "esbuild"
    ]
  }
}
