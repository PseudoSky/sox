{
  "$schema": "https://your-registry/schemas/extension/v2.json",
  "id": "di-skill",
  "type": "skill",
  "title": "di-skill",
  "description": "Use this when you need a skill that demonstrates dependency injection for Claude-based workflows.",
  "keywords": ["dependency-injection", "demo", "skill"],
  "author": "sox-ecosystem",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "runtime": "declarative",
  "entrypoint": "SKILL.md",
  "run_interface": {
    "input_schema": {"type": "object", "properties": {}},
    "output_schema": {"type": "object", "properties": {}}
  },
  "install": {
    "type": "skill",
    "hosts": ["claude", "opencode"]
  }
}
