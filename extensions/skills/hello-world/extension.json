{
  "$schema": "https://your-registry/schemas/extension/v1.json",
  "id": "hello-world",
  "version": "0.1.0",
  "type": "skill",
  "title": "Hello World",
  "description": "Use this when you need a minimal working skill to verify the extension scaffold or test a new host integration — processes a text input and returns it prefixed with 'Processed:'.",
  "keywords": ["example", "scaffold", "reference", "hello-world"],
  "author": "sox-ecosystem",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "entrypoint": "dist/index.js",
  "run_interface": {
    "input_schema": {
      "type": "object",
      "properties": {
        "input": { "type": "string", "description": "Input to process" }
      },
      "required": ["input"]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "result": { "type": "string", "description": "Processed output prefixed with 'Processed:'" }
      },
      "required": ["result"]
    }
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {},
    "description": "Hello world skill accepts no configuration."
  },
  "permissions": {}
}
