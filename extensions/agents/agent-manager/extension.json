{
  "$schema": "https://your-registry/schemas/extension/v2.json",
  "id": "agent-manager",
  "version": "0.2.2",
  "type": "agent",
  "title": "agent-manager",
  "description": "Use this when you need to craft, test, or manage agents, skills, and plugins across opencode and Claude Code — e.g. \"create an agent\", \"build a skill or plugin\", \"A/B test this agent\", \"optimize this prompt\", \"make a Claude plugin\", \"lazy-load my agents\", \"check your backlog\", or any cross-runtime agent-management work.",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "author": "sox-ecosystem",
  "keywords": [
    "agent-manager",
    "agent",
    "declarative"
  ],
  "runtime": "declarative",
  "entrypoint": "agent-manager.md",
  "invocation": {
    "protocol": "function-export",
    "handler": "run",
    "description": "Declarative agent — host reads the prose body and renders the host header from agent/render at install time."
  },
  "agent": {
    "name": "agent-manager",
    "description": "Use this when you need to craft, test, or manage agents, skills, and plugins across opencode and Claude Code — e.g. \"create an agent\", \"build a skill or plugin\", \"A/B test this agent\", \"optimize this prompt\", \"make a Claude plugin\", \"lazy-load my agents\", \"check your backlog\", or any cross-runtime agent-management work.",
    "model": "haiku",
    "mode": "all",
    "temperature": 0.2,
    "tools": [
      "edit",
      "bash",
      "webfetch",
      "websearch",
      "skill",
      "task",
      "todowrite",
      "question"
    ],
    "permission": {
      "edit": "allow",
      "bash": {
        "*": "allow",
        "head *": "allow",
        "tail *": "allow",
        "cat *": "allow",
        "ls *": "allow",
        "wc *": "allow",
        "sort *": "allow",
        "uniq *": "allow",
        "cut *": "allow",
        "tr *": "allow",
        "printf *": "allow",
        "echo *": "allow",
        "awk *": "allow",
        "sed *": "allow",
        "diff *": "allow",
        "comm *": "allow",
        "cmp *": "allow",
        "od *": "allow",
        "strings *": "allow",
        "stat *": "allow",
        "column *": "allow",
        "basename *": "allow",
        "dirname *": "allow",
        "readlink *": "allow",
        "which *": "allow",
        "true": "allow",
        "test *": "allow",
        "date *": "allow",
        "sleep *": "allow",
        "rg *": "allow",
        "grep *": "allow",
        "gx *": "allow",
        "find *": "allow",
        "mktemp *": "allow",
        "mkdir *": "allow",
        "touch *": "allow",
        "cp *": "allow",
        "tee *": "allow",
        "file *": "allow",
        "env": "allow",
        "seq *": "allow",
        "ps *": "allow",
        "shasum *": "allow",
        "sha256sum *": "allow",
        "cksum *": "allow",
        "node *": "allow",
        "python3 *": "allow",
        "sqlite3 *": "allow",
        "opencode *": "allow",
        "npm view *": "allow",
        "npx nx list*": "allow",
        "curl -s*": "allow",
        "gh *": "allow",
        "adhd-backlog *": "allow",
        "agent-failure-report*": "allow",
        "SOX_SANDBOX_ROOT=* node *": "allow",
        "git --version*": "allow",
        "git --no-pager *": "allow",
        "git --exec-path*": "allow",
        "git -c *": "allow",
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "git show*": "allow",
        "git rev-parse*": "allow",
        "git rev-list*": "allow",
        "git reflog*": "allow",
        "git ls-files*": "allow",
        "git ls-remote*": "allow",
        "git cat-file*": "allow",
        "git hash-object*": "allow",
        "git check-ignore*": "allow",
        "git for-each-ref*": "allow",
        "git merge-base*": "allow",
        "git merge-tree*": "allow",
        "git symbolic-ref*": "allow",
        "git branch --list*": "allow",
        "git branch -a*": "allow",
        "git branch --show-current*": "allow",
        "git worktree list*": "allow",
        "git config --get*": "allow",
        "git -C * status*": "allow",
        "git -C * diff*": "allow",
        "git -C * log*": "allow",
        "git -C * show*": "allow",
        "git -C * rev-parse*": "allow",
        "git -C * rev-list*": "allow",
        "git -C * ls-files*": "allow",
        "git -C * worktree list*": "allow",
        "git -C * merge-base*": "allow",
        "git -C * config --get*": "allow",
        "git add *": "allow",
        "git commit*": "allow",
        "git fetch*": "allow",
        "git push*": "allow",
        "git merge*": "allow",
        "git mv*": "allow",
        "git rm*": "allow",
        "git init*": "allow",
        "git config*": "allow",
        "git reset *": "allow",
        "git worktree add*": "allow",
        "git worktree remove*": "allow",
        "git worktree prune*": "allow",
        "git switch*": "allow",
        "git branch -d*": "allow",
        "git restore *": "allow",
        "git checkout*": "ask",
        "git rebase*": "ask",
        "git update-ref*": "ask",
        "sed -i*": "ask",
        "find * -delete*": "ask",
        "find * -exec*": "ask",
        "git stash*": "deny",
        "git add -A*": "deny",
        "git add --all*": "deny",
        "git add .": "deny",
        "git reset --hard*": "deny",
        "git push *--force*": "deny",
        "git push *--no-verify*": "deny",
        "git branch -D*": "deny",
        "git clean *-f*": "deny",
        "rm -rf *": "deny",
        "git checkout -- *": "ask",
        "*dot/secrets*": "deny"
      },
      "webfetch": "allow",
      "websearch": "allow",
      "skill": "allow",
      "task": "allow",
      "todowrite": "allow",
      "question": "allow",
      "external_directory": {
        "~/.config/opencode/**": "allow",
        "~/.claude/**": "allow",
        "~/.agents/**": "allow"
      }
    }
  },
  "render": {
    "claude": {
      "model": "haiku",
      "version": "v0.2.2"
    },
    "opencode": {
      "model": "deepseek/deepseek-flash",
      "mode": "all",
      "temperature": 0.2
    }
  },
  "install": {
    "type": "agent",
    "hosts": [
      "claude",
      "opencode"
    ]
  },
  "dependencies": [
    "agent-safety-audit"
  ],
  "requires": {
    "tool_calling": true
  }
}
