{
  "$schema": "https://your-registry/schemas/extension/v2.json",
  "id": "memory-org",
  "version": "0.1.3",
  "type": "agent",
  "title": "org-agent",
  "description": "Use this when you need an agent that organises or retrieves memories scoped to a project or organisation.",
  "keywords": ["memory", "organisation", "agent"],
  "author": "sox-ecosystem",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "runtime": "declarative",
  "entrypoint": "org-agent.md",
  "invocation": {
    "protocol": "function-export",
    "handler": "run",
    "description": "Declarative agent — host reads the prose body and renders the host header from agent/render at install time."
  },
  "requires": {
    "tool_calling": true
  },
  "agent": {
    "name": "org-agent",
    "description": "Agent that organises or retrieves memories scoped to a project or organisation.",
    "model": "sonnet",
    "tools": [
      "read",
      "write",
      "edit",
      "bash",
      "glob",
      "grep"
    ],
    "permission": {
      "read": "allow",
      "write": "allow",
      "edit": "allow",
      "bash": {
        "*": "allow",
        "git stash*": "deny",
        "git add -A*": "deny",
        "git add .": "deny",
        "git add --all*": "deny",
        "git reset --hard*": "deny",
        "git push *--no-verify*": "ask",
        "git clean *-f*": "deny",
        "git checkout -- *": "ask",
        "rm -rf *": "ask",
        "*dot/secrets*": "deny"
      },
      "glob": "allow",
      "grep": "allow"
    }
  },
  "render": {
    "claude": {
      "model": "sonnet",
      "version": "v0.1.3"
    },
    "opencode": {
      "model": "deepseek/deepseek-flash"
    }
  },
  "install": {
    "type": "agent",
    "hosts": ["claude", "opencode"]
  }
}
