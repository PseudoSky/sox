{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-organizer",
  "projectType": "library",
  "root": "extensions/agents/memory-organizer",
  "sourceRoot": "extensions/agents/memory-organizer/src",
  "tags": ["type:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/extensions/agents/memory-organizer/dist"],
      "options": {
        "command": "tsc --project extensions/agents/memory-organizer/tsconfig.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["extensions/agents/memory-organizer/src/**/*.ts"]
      }
    }
  }
}
