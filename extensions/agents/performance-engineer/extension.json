{
  "$schema": "https://your-registry/schemas/extension/v2.json",
  "id": "performance-engineer",
  "version": "0.1.3",
  "type": "agent",
  "title": "performance-engineer",
  "description": "Use this agent when you need to identify and eliminate performance bottlenecks in applications, databases, or infrastructure systems, and when baseline performance metrics need improvement.",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "author": "sox-ecosystem",
  "keywords": [
    "performance-engineer",
    "agent",
    "declarative"
  ],
  "runtime": "declarative",
  "entrypoint": "performance-engineer.md",
  "invocation": {
    "protocol": "function-export",
    "handler": "run",
    "description": "Declarative agent — host reads the prose body and renders the host header from agent/render at install time."
  },
  "requires": {
    "tool_calling": true
  },
  "agent": {
    "name": "performance-engineer",
    "description": "Use this agent when you need to identify and eliminate performance bottlenecks in applications, databases, or infrastructure systems, and when baseline performance metrics need improvement.",
    "model": "sonnet",
    "tools": [
      "read",
      "write",
      "edit",
      "bash",
      "glob",
      "grep",
      "question",
      "websearch",
      {
        "logical": "memory",
        "server": "memory-server"
      },
      {
        "logical": "backlog",
        "server": "backlog"
      }
    ],
    "permission": {
      "read": "allow",
      "write": "allow",
      "edit": "allow",
      "bash": {
        "*": "allow",
        "git stash*": "deny",
        "git add -A*": "deny",
        "git add .": "deny",
        "git add --all*": "deny",
        "git reset --hard*": "deny",
        "git push *--no-verify*": "ask",
        "git clean *-f*": "deny",
        "git checkout -- *": "ask",
        "rm -rf *": "ask",
        "*dot/secrets*": "deny"
      },
      "glob": "allow",
      "grep": "allow",
      "question": "allow",
      "websearch": "allow",
      "memory_*": "allow",
      "backlog_*": "allow"
    }
  },
  "render": {
    "claude": {
      "model": "sonnet",
      "version": "v0.1.3",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Bash",
        "Glob",
        "Grep",
        "AskUserQuestion",
        "WebSearch",
        "mcp__memory-server__*",
        "mcp__backlog__*"
      ],
      "toolMap": {
        "memory-server": "memory-server",
        "backlog": "backlog"
      }
    },
    "opencode": {
      "model": "deepseek/deepseek-flash",
      "mode": "all"
    },
    "agent-mcp": {
      "model": "deepseek/deepseek-flash",
      "toolMap": {
        "memory": "memory-server",
        "code-intel": "gitnexus",
        "search": "search",
        "backlog": "backlog"
      },
      "mcpServers": {
        "search": {
          "transport": "stdio",
          "command": "node",
          "args": [
            "${HOME}/dev/ai/scratch/agent-browser/server.mjs",
            "--transport",
            "stdio",
            "--ns",
            "agent",
            "--drop-file-segment"
          ]
        },
        "memory-server": {
          "transport": "sse",
          "url": "http://localhost:3099/sse",
          "timeoutMs": 40000
        },
        "gitnexus": {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "gitnexus",
            "mcp"
          ]
        },
        "backlog": {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "--prefer-online=false",
            "@adhd/backlog@latest",
            "serve",
            "--transport",
            "mcp"
          ],
          "timeoutMs": 45000
        }
      },
      "nativeTooling": {
        "shell": {
          "allowCommands": [
            "basename",
            "cat",
            "cp",
            "diff",
            "dirname",
            "gx",
            "head",
            "ls",
            "mkdir",
            "mv",
            "npx",
            "nx",
            "pnpm",
            "rg",
            "sort",
            "sox-git-impl",
            "sox-git-ro",
            "sox-rm",
            "stat",
            "tail",
            "tee",
            "touch",
            "uniq",
            "wc",
            "which"
          ],
          "timeoutMs": 900000
        }
      }
    }
  },
  "install": {
    "type": "agent",
    "hosts": [
      "claude",
      "opencode",
      "agent-mcp",
      "codex"
    ]
  },
  "capabilities": [
    "roles-covered:none"
  ]
}
