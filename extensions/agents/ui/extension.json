{
  "$schema": "https://your-registry/schemas/extension/v2.json",
  "id": "ui",
  "version": "0.1.1",
  "type": "agent",
  "title": "UI Engineer",
  "description": "Use this when building or changing user-facing interface code — components, design systems, styling, theming, accessibility, or front-end performance — across React, Vue, Angular, and Expo/React Native. Owns the path from visual language to shipped, accessible, performant UI; framework specifics load on demand from the ui-playbooks skill.",
  "compatibility": {
    "host": ">=1.0.0 <2.0.0"
  },
  "license": "MIT",
  "author": "sox-ecosystem",
  "keywords": [
    "ui",
    "frontend",
    "design-system",
    "react",
    "vue",
    "angular",
    "expo",
    "accessibility",
    "wcag"
  ],
  "runtime": "declarative",
  "entrypoint": "ui.md",
  "invocation": {
    "protocol": "function-export",
    "handler": "run",
    "description": "Declarative agent — host reads the prose body and renders the host header from agent/render at install time."
  },
  "agent": {
    "name": "ui",
    "description": "Senior UI engineer: design systems, components, styling, theming, accessibility, and front-end performance across React, Vue, Angular, and Expo/React Native.",
    "model": "sonnet",
    "mode": "all",
    "temperature": 0.2,
    "tools": [
      "read",
      "glob",
      "grep",
      "bash",
      "write",
      "edit",
      "webfetch",
      "websearch",
      "skill",
      "todowrite",
      "question"
    ],
    "permission": {
      "read": "allow",
      "edit": "allow",
      "webfetch": "allow",
      "websearch": "allow",
      "skill": "allow",
      "todowrite": "allow",
      "question": "allow",
      "bash": {
        "*": "allow",
        "rm -rf *": "deny",
        "git reset --hard*": "deny",
        "git stash*": "deny",
        "git add -A*": "deny",
        "git add .": "deny"
      },
      "external_directory": {
        "~/.config/opencode/**": "allow",
        "/Users/nix/dev/ai/**": "allow"
      }
    }
  },
  "render": {
    "codex": {},
    "claude": {
      "model": "sonnet",
      "version": "v0.1.1",
      "tools": [
        "Read",
        "Glob",
        "Grep",
        "Bash",
        "Write",
        "Edit",
        "WebFetch",
        "WebSearch",
        "Skill",
        "TodoWrite",
        "AskUserQuestion"
      ]
    },
    "opencode": {
      "model": "deepseek/deepseek-flash",
      "mode": "all",
      "temperature": 0.2
    },
    "agent-mcp": {
      "model": "deepseek/deepseek-flash",
      "toolMap": {
        "memory": "memory-server",
        "code-intel": "gitnexus",
        "search": "search",
        "backlog": "backlog"
      },
      "mcpServers": {
        "search": {
          "transport": "stdio",
          "command": "node",
          "args": [
            "${HOME}/dev/ai/scratch/agent-browser/server.mjs",
            "--transport",
            "stdio",
            "--ns",
            "agent",
            "--drop-file-segment"
          ]
        },
        "memory-server": {
          "transport": "sse",
          "url": "http://localhost:3099/sse",
          "timeoutMs": 40000
        },
        "gitnexus": {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "gitnexus",
            "mcp"
          ]
        },
        "backlog": {
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "--prefer-online=false",
            "@adhd/backlog@latest",
            "serve",
            "--transport",
            "mcp"
          ],
          "timeoutMs": 45000
        }
      },
      "nativeTooling": {
        "shell": {
          "allowCommands": [
            "basename",
            "cat",
            "cp",
            "diff",
            "dirname",
            "gx",
            "head",
            "ls",
            "mkdir",
            "mv",
            "npx",
            "nx",
            "pnpm",
            "rg",
            "sort",
            "sox-git-impl",
            "sox-git-ro",
            "sox-rm",
            "stat",
            "tail",
            "tee",
            "touch",
            "uniq",
            "wc",
            "which"
          ],
          "timeoutMs": 900000
        }
      }
    }
  },
  "install": {
    "type": "agent",
    "hosts": [
      "claude",
      "opencode",
      "agent-mcp",
      "codex"
    ]
  },
  "dependencies": [
    "ui-playbooks",
    "browser-testing"
  ],
  "requires": {
    "tool_calling": true
  },
  "capabilities": [
    "roles-covered:IM.1"
  ]
}
