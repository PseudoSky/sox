{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-server",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-server",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-server/src",
  "tags": [
    "type:extension"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-server/dist"
      ],
      "options": {
        "command": "tsc --project extensions/bundles/sox-memory-bundle/members/memory-server/tsconfig.json && node extensions/bundles/sox-memory-bundle/members/memory-server/scripts/gen-schema.cjs",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/scripts/gen-schema.cjs"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/bundles/sox-memory-bundle/members/memory-server/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "extensions/bundles/sox-memory-bundle/members/memory-server/src/**/*.ts"
        ]
      }
    }
  }
}
