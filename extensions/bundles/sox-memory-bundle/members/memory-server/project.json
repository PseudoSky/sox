{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-server",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-server",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-server/src",
  "tags": [
    "type:extension"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-server/dist"
      ],
      "options": {
        "commands": [
          "rm -rf extensions/bundles/sox-memory-bundle/members/memory-server/dist",
          "node tools/bundle-extension.cjs --entry extensions/bundles/sox-memory-bundle/members/memory-server/src/index.ts --outdir extensions/bundles/sox-memory-bundle/members/memory-server/dist --tsconfig extensions/bundles/sox-memory-bundle/members/memory-server/tsconfig.json --worker libs/data/embed/embedding-provider/src/embedWorker.ts --external better-sqlite3 --external sqlite-vec --external fastembed --external onnxruntime-node",
          "node extensions/bundles/sox-memory-bundle/members/memory-server/scripts/gen-schema.cjs"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/scripts/gen-schema.cjs",
        "{workspaceRoot}/tools/bundle-extension.cjs",
        "{workspaceRoot}/libs/data/embed/embedding-provider/src/embedWorker.ts"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/bundles/sox-memory-bundle/members/memory-server/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "extensions/bundles/sox-memory-bundle/members/memory-server/src/**/*.ts"
        ]
      }
    }
  }
}
