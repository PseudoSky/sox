{
  "name": "@adhd/sox-extension-memory-server",
  "version": "1.3.3",
  "description": "sox-memory MCP server (stdio/http/sse) — 20 memory_* tools over a Turso (default, multiprocess-write) or SQLite graph store, with hybrid recall and deterministic in-process enrichment",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "extension.json"
  ],
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "sqlite-vec": "^0.1.9",
    "fastembed": "^2.1.0",
    "onnxruntime-node": "1.21.0",
    "@tursodatabase/database": "^0.7.1"
  },
  "devDependencies": {
    "@adhd/sox-memory-core": "workspace:*",
    "@adhd/sox-store-adapter": "workspace:*",
    "@adhd/sox-mcp-runtime": "workspace:*",
    "@adhd/sox-service-proxy": "workspace:*",
    "@adhd/sox-telemetry": "workspace:*"
  },
  "keywords": [
    "mcp",
    "memory",
    "server",
    "sqlite",
    "graph",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git"
  },
  "homepage": "https://github.com/PseudoSky/adhd"
}
