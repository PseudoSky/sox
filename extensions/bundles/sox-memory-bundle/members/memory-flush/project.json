{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-flush",
  "description": "Builds cleanly and resolves @adhd/sox-memory-core from workspace (verified 2026-06-22).",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-flush",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-flush/src",
  "tags": [
    "type:extension"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-flush/dist"
      ],
      "options": {
        "command": "tsc --project extensions/bundles/sox-memory-bundle/members/memory-flush/tsconfig.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "extensions/bundles/sox-memory-bundle/members/memory-flush/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/bundles/sox-memory-bundle/members/memory-flush/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "dependsOn": [
        "^build"
      ]
    }
  }
}
