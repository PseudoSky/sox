{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-daemon",
  "description": "Builds cleanly and resolves @sox/memory-core from workspace (verified 2026-06-22).",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-daemon",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-daemon/src",
  "tags": ["type:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-daemon/dist"],
      "options": {
        "command": "tsc --project extensions/bundles/sox-memory-bundle/members/memory-daemon/tsconfig.json && printf '{\"type\":\"commonjs\"}\\n' > extensions/bundles/sox-memory-bundle/members/memory-daemon/dist/package.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["extensions/bundles/sox-memory-bundle/members/memory-daemon/src/**/*.ts"]
      }
    }
  }
}
