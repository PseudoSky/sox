{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-daemon",
  "description": "Builds cleanly and resolves @adhd/sox-memory-core and @adhd/sox-memory-enrich from workspace (P6: LLM organizer removed, deterministic batch enrichment via runBatchEnrich).",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-daemon",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-daemon/src",
  "tags": ["type:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-daemon/dist",
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-daemon/bundle"
      ],
      "options": {
        "commands": [
          "tsc --project extensions/bundles/sox-memory-bundle/members/memory-daemon/tsconfig.json && printf '{\"type\":\"commonjs\"}\\n' > extensions/bundles/sox-memory-bundle/members/memory-daemon/dist/package.json",
          "node tools/bundle-extension.cjs --entry extensions/bundles/sox-memory-bundle/members/memory-daemon/src/bin.ts --outdir extensions/bundles/sox-memory-bundle/members/memory-daemon/bundle --tsconfig extensions/bundles/sox-memory-bundle/members/memory-daemon/tsconfig.json --external better-sqlite3 --external sqlite-vec"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": ["memory-core:build", "memory-enrich:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["extensions/bundles/sox-memory-bundle/members/memory-daemon/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'memory-daemon: no unit tests (integration tested via e2e)'",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts"
      ]
    }
  }
}
