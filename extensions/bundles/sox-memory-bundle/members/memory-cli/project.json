{
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-cli",
  "description": "Builds cleanly and resolves @adhd/sox-memory-core from workspace (verified 2026-06-22).",
  "projectType": "library",
  "root": "extensions/bundles/sox-memory-bundle/members/memory-cli",
  "sourceRoot": "extensions/bundles/sox-memory-bundle/members/memory-cli/src",
  "tags": [
    "type:extension"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/bundles/sox-memory-bundle/members/memory-cli/dist"
      ],
      "options": {
        "commands": [
          "node tools/bundle-extension.cjs --entry extensions/bundles/sox-memory-bundle/members/memory-cli/src/index.ts --outdir extensions/bundles/sox-memory-bundle/members/memory-cli/dist --tsconfig extensions/bundles/sox-memory-bundle/members/memory-cli/tsconfig.json --external better-sqlite3 --external sqlite-vec --external fastembed --external onnxruntime-node"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tools/bundle-extension.cjs",
        "{workspaceRoot}/libs/data/embed/embedding-provider/src/embedWorker.ts",
        "{workspaceRoot}/libs/data/embed/embedding-provider/src/fastembedProcessHost.ts",
        "{workspaceRoot}/libs/data/embed/embedding-provider/src/sharedOnnxWorker.ts",
        "{workspaceRoot}/libs/data/embed/embedding-provider/package.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/bundles/sox-memory-bundle/members/memory-cli/vitest.config.mts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "extensions/bundles/sox-memory-bundle/members/memory-cli/src/**/*.ts"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p extensions/bundles/sox-memory-bundle/members/memory-cli/tsconfig.json --noEmit",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    }
  }
}
