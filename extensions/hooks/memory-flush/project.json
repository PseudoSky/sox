{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-flush",
  "projectType": "library",
  "root": "extensions/hooks/memory-flush",
  "sourceRoot": "extensions/hooks/memory-flush/src",
  "tags": ["type:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/extensions/hooks/memory-flush/dist"],
      "options": {
        "command": "tsc --project extensions/hooks/memory-flush/tsconfig.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": ["memory-core:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["extensions/hooks/memory-flush/src/**/*.ts"]
      }
    }
  }
}
