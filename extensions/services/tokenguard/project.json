{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "tokenguard",
  "projectType": "library",
  "root": "extensions/services/tokenguard",
  "sourceRoot": "extensions/services/tokenguard/src",
  "tags": [
    "type:extension"
  ],
  "targets": {
    "compile": {
      "executor": "@adhd/sox-nx:atomic-tsc",
      "outputs": [
        "{workspaceRoot}/extensions/services/tokenguard/dist"
      ],
      "options": {
        "main": "extensions/services/tokenguard/src/index.ts",
        "outputPath": "extensions/services/tokenguard/dist",
        "tsConfig": "extensions/services/tokenguard/tsconfig.json",
        "assets": [],
        "clean": true,
        "rootDir": "extensions/services/tokenguard/src",
        "generatePackageJson": false
      },
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/services/tokenguard/dist",
        "{workspaceRoot}/extensions/services/tokenguard/bundle"
      ],
      "options": {
        "command": "node tools/bundle-extension.cjs --entry extensions/services/tokenguard/src/index.ts --outdir extensions/services/tokenguard/bundle --tsconfig extensions/services/tokenguard/tsconfig.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/bundle-extension.cjs"
      ],
      "dependsOn": [
        "compile",
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/services/tokenguard/vitest.config.mts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "extensions/services/tokenguard/src/**/*.ts"
        ]
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/extensions/services/tokenguard/bundle"
      ],
      "options": {
        "command": "node tools/bundle-extension.cjs --entry extensions/services/tokenguard/src/index.ts --outdir extensions/services/tokenguard/bundle --tsconfig extensions/services/tokenguard/tsconfig.json",
        "cwd": "."
      },
      "dependsOn": [
        "build"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p extensions/services/tokenguard/tsconfig.json --noEmit",
        "cwd": "."
      },
      "cache": true,
      "inputs": ["default", "^production"]
    }
  }
}
