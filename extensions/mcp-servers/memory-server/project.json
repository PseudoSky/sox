{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "memory-server",
  "projectType": "library",
  "root": "extensions/mcp-servers/memory-server",
  "sourceRoot": "extensions/mcp-servers/memory-server/src",
  "tags": ["type:extension"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/extensions/mcp-servers/memory-server/dist"],
      "options": {
        "command": "tsc --project extensions/mcp-servers/memory-server/tsconfig.json",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.json"
      ],
      "dependsOn": ["memory-core:build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config extensions/mcp-servers/memory-server/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/*.test.ts",
        "{projectRoot}/vitest.config.ts"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["extensions/mcp-servers/memory-server/src/**/*.ts"]
      }
    }
  }
}
