{
  "name": "@adhd/sox-cli",
  "version": "1.2.1",
  "description": "soxe CLI — LLM extension ecosystem command-line interface (extension #0)",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node scripts/check-bundled-registry.cjs",
    "prepublishOnly": "node scripts/check-bundled-registry.cjs"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "soxe": "./bin/soxe.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@adhd/sox-authoring": "workspace:*",
    "@adhd/sox-host-registry": "workspace:*",
    "@adhd/sox-host-runtime": "workspace:*",
    "@adhd/sox-install-engine": "workspace:*",
    "@adhd/sox-listen-guard": "workspace:^",
    "@adhd/sox-manifest": "workspace:*",
    "@adhd/sox-mcp-runtime": "workspace:*",
    "@adhd/sox-registry": "workspace:*",
    "@adhd/sox-service-proxy": "workspace:*",
    "@adhd/sox-telemetry": "workspace:*"
  },
  "keywords": [
    "sox",
    "cli",
    "extension-manager",
    "llm",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PseudoSky/adhd.git"
  },
  "homepage": "https://github.com/PseudoSky/adhd"
}
