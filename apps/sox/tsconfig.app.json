{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "outDir": "../../dist/apps/sox",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "paths": {
      "@adhd/sox-manifest": ["libs/manifest/dist/index.d.ts"],
      "@adhd/sox-authoring": ["libs/authoring/dist/index.d.ts"],
      "@adhd/sox-install-engine": ["libs/install-engine/dist/index.d.ts"],
      "@adhd/sox-host-runtime": ["libs/host-runtime/dist/index.d.ts"],
      "@adhd/sox-host-registry": ["libs/host-registry/dist/index.d.ts"],
      "@adhd/sox-registry": ["libs/registry/dist/index.d.ts"],
      "@adhd/sox-service-proxy": ["libs/service-proxy/dist/index.d.ts"],
      "@adhd/sox-telemetry": ["libs/observability/sox-telemetry/dist/index.d.ts", "libs/observability/sox-telemetry/dist/index.js"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
