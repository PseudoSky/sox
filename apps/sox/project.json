{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sox",
  "projectType": "application",
  "root": "apps/sox",
  "sourceRoot": "apps/sox/src",
  "tags": [
    "type:app"
  ],
  "implicitDependencies": [
    "service-proxy",
    "install-engine",
    "host-registry",
    "host-runtime",
    "manifest",
    "authoring",
    "registry"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/sox",
        "{projectRoot}/dist"
      ],
      "options": {
        "commands": [
          "tsc --project apps/sox/tsconfig.app.json && echo '{\"type\":\"commonjs\"}' > dist/apps/sox/package.json && node apps/sox/scripts/rewrite-paths.cjs && node apps/sox/scripts/stamp-build.cjs",
          "node tools/bundle-extension.cjs --entry apps/sox/src/main.ts --outdir apps/sox/dist --tsconfig apps/sox/tsconfig.app.json",
          "node apps/sox/scripts/embed-registry.cjs"
        ],
        "parallel": false,
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/extension.json",
        "{projectRoot}/scripts/rewrite-paths.cjs",
        "{projectRoot}/scripts/stamp-build.cjs",
        "{projectRoot}/scripts/embed-registry.cjs",
        "{workspaceRoot}/tools/bundle-extension.cjs",
        "{workspaceRoot}/registry/index.json"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/sox/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/sox/**/*.ts"
        ]
      }
    }
  }
}
