{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sox",
  "projectType": "application",
  "root": "apps/sox",
  "sourceRoot": "apps/sox/src",
  "tags": [
    "type:app"
  ],
  "implicitDependencies": [
    "service-proxy"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/apps/sox"
      ],
      "options": {
        "command": "tsc --project apps/sox/tsconfig.app.json && echo '{\"type\":\"commonjs\"}' > dist/apps/sox/package.json && node apps/sox/scripts/rewrite-paths.cjs",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/extension.json",
        "{projectRoot}/scripts/rewrite-paths.cjs"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/sox/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/sox/**/*.ts"
        ]
      }
    }
  }
}
