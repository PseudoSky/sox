#!/usr/bin/env node
// soxe — sox-ecosystem CLI shim (avoids collision with system soxe audio tool)
// Routes to the compiled CommonJS dist. The --require flag or createRequire is
// needed because the root package.json has "type":"module" but dist/apps/sox
// is CommonJS (it writes its own package.json with type:commonjs at build time).
import { createRequire } from 'module';
import { dirname, resolve } from 'path';
import { fileURLToPath } from 'url';
const __dirname = dirname(fileURLToPath(import.meta.url));
createRequire(import.meta.url)(resolve(__dirname, '../dist/apps/sox/main.js'));
