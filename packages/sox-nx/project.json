{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sox-nx",
  "projectType": "library",
  "root": "packages/sox-nx",
  "sourceRoot": "packages/sox-nx/src",
  "tags": [
    "type:lib",
    "area:platform",
    "group:devtools"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/packages/sox-nx/dist"
      ],
      "options": {
        "main": "packages/sox-nx/src/index.ts",
        "outputPath": "packages/sox-nx/dist",
        "tsConfig": "packages/sox-nx/tsconfig.lib.json",
        "assets": [],
        "clean": true
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/tsconfig.lib.json"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/sox-nx/vitest.config.ts",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "born-conformance": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/born-conformance.js",
        "cwd": "."
      },
      "cache": false,
      "dependsOn": [
        "authoring:build",
        "manifest:build"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/sox-nx/**/*.ts"
        ]
      }
    }
  }
}