{
  "name": "@adhd/sox-nx",
  "version": "0.1.2",
  "description": "Nx plugin for sox — thin generator adapters over libs/authoring",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "executors": "./executors.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./executors.json": "./executors.json"
  },
  "dependencies": {
    "@adhd/sox-authoring": "workspace:*"
  },
  "peerDependencies": {
    "@nx/devkit": ">=22.0.0",
    "@nx/js": ">=22.0.0"
  }
}
