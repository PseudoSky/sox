{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "pro": {
      "description": "System design + tool research + orchestration. Plans large features, decomposes into dispatchable segments, knows when to use flash vs implement",
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/prompts/pro-system.md}",
      "temperature": 0,
      "steps": 20,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "todowrite": "deny",
        "question": "deny",
        "skill": "allow",
        "memory_*": "allow"
      }
    },
    "implement": {
      "description": "Complex implementation agent (pro model) \u2014 multi-file changes, interface design, refactors, debugging. For well-specified simple tasks, use flash instead",
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:.opencode/prompts/implement-system.md}",
      "temperature": 0.1,
      "steps": 40,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "skill": "allow",
        "memory_*": "allow"
      }
    },
    "flash": {
      "description": "Fast implementation agent (flash model) \u2014 single-file changes, manifest edits, boilerplate, well-specified tasks with exact code provided",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:.opencode/prompts/flash-system.md}",
      "temperature": 0.1,
      "steps": 30,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "skill": "allow",
        "memory_*": "allow"
      }
    }
  },
  "provider": {
    "cf-proxy": {
      "name": "CF Proxy",
      "options": {
        "baseURL": "http://localhost:3333/v1"
      },
      "models": {
        "deepseek-rf": {
          "id": "deepseek-rf",
          "name": "DeepSeek (RF \u2014 passthrough)",
          "cost": {
            "input": 0.00027,
            "output": 0.0011
          }
        },
        "cf-v4-flash": {
          "id": "cf-v4-flash",
          "name": "DeepSeek V4 Flash (CF \u2014 rewrite)",
          "cost": {
            "input": 0.00027,
            "output": 0.0011
          }
        }
      }
    }
  },
  "mcp": {
    "memory-server": {
      "type": "remote",
      "url": "http://localhost:3099/sse"
    }
  },
  "model": "deepseek-rf"
}