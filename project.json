{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "sox-ecosystem",
  "projectType": "application",
  "root": ".",
  "sourceRoot": ".",
  "targets": {
    "routing:build-index": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/build-routing-index.ts",
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/docs/routing/map.json",
        "{workspaceRoot}/docs/routing/INDEX.md",
        "{workspaceRoot}/libs/data/INDEX.md"
      ],
      "cache": false
    },
    "routing:check-drift": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx scripts/check-routing-drift.ts",
        "cwd": "."
      },
      "cache": false
    },
    "test": {
      "dependsOn": [
        {
          "projects": [
            "sox"
          ],
          "target": "build"
        },
        "^build"
      ]
    },
    "guards-tier1": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/run-guards.mjs --tier1 --all", "cwd": "." },
      "cache": false
    },
    "guards-tier2": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/run-guards.mjs --tier2", "cwd": "." },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "scripts/**/*.ts",
          "scripts/**/*.js",
          "scripts/**/*.mjs",
          "scripts/**/*.cjs",
          "tools/**/*.ts",
          "tools/**/*.js",
          "tools/**/*.mjs",
          "tools/**/*.cjs",
          "*.ts",
          "*.js",
          "*.mjs",
          "*.cjs"
        ]
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/project.json",
        "{workspaceRoot}/scripts/**/*.ts",
        "{workspaceRoot}/scripts/**/*.js",
        "{workspaceRoot}/scripts/**/*.mjs",
        "{workspaceRoot}/scripts/**/*.cjs",
        "{workspaceRoot}/tools/**/*.ts",
        "{workspaceRoot}/tools/**/*.js",
        "{workspaceRoot}/tools/**/*.mjs",
        "{workspaceRoot}/tools/**/*.cjs",
        "{workspaceRoot}/*.ts",
        "{workspaceRoot}/*.js",
        "{workspaceRoot}/*.mjs",
        "{workspaceRoot}/*.cjs"
      ]
    }
  }
}
