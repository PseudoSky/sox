{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@adhd/sox-manifest": ["libs/manifest/src/index.ts", "libs/manifest/dist/index.js"],
      "@adhd/sox-authoring": ["libs/authoring/dist/index.js"],
      "@adhd/sox-install-engine": ["libs/install-engine/dist/index.js"],
      "@adhd/sox-host-runtime": ["libs/host-runtime/dist/index.js"],
      "@adhd/sox-registry": ["libs/registry/dist/index.js"],
      "@adhd/sox-memory-core": ["libs/memory-core/dist/index.d.ts"],
      "@adhd/sox-memory-enrich": ["libs/memory-enrich/dist/index.d.ts"],
      "@adhd/sox-mcp-runtime": ["libs/mcp-runtime/dist/index.d.ts"],
      "@adhd/sox-service-proxy": ["libs/service-proxy/dist/index.d.ts", "libs/service-proxy/dist/index.js"],
      "@adhd/sox-telemetry": ["libs/observability/sox-telemetry/dist/index.d.ts", "libs/observability/sox-telemetry/dist/index.js"]
    }
  },
  "include": ["scripts/**/*.ts", "extensions/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
