{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@sox/manifest": ["libs/manifest/dist/index.js"],
      "@sox/authoring": ["libs/authoring/dist/index.js"],
      "@sox/install-engine": ["libs/install-engine/dist/index.js"],
      "@sox/host-runtime": ["libs/host-runtime/dist/index.js"],
      "@sox/registry": ["libs/registry/dist/index.js"],
      "@sox/memory-core": ["libs/memory-core/dist/index.d.ts"]
    }
  },
  "include": ["scripts/**/*.ts", "extensions/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
