node_modules/

__pycache__
dist/

# [BL-313] bundle-extension.cjs auto-discovered static assets (e.g. graph-store's
# Drizzle migrations folder) land as a sibling of a bundled extension's dist/ —
# build output, copied fresh from the owning package's own tracked source
# (libs/data/graph/graph-store/drizzle/migrations/ IS tracked) on every build.
extensions/**/drizzle/

# [BL-235] Atomic-build scratch dirs. `dist/` above does NOT match `dist.staging-1234`
# or `dist.prev-1234`. Both bundle-extension.cjs and @adhd/sox-nx:atomic-tsc stage a
# build into a sibling dir and swap it in on success; a hard-killed build (OOM, ^C,
# session limit) can leave one behind. They must never show up as untracked noise, and
# must never be committed.
*.staging-*
*.prev-*

*.js.map
*.d.ts.map
.extensions/extensions.local.json
*.lock
!pnpm-lock.yaml
# [ADR-0011 R5] tools/bl-id-counter.mjs's shared-root state file. Lives at the SAME git-common-dir
# -resolved main-checkout path as BACKLOG.md/CHANGELOG.md/.bl-id.lock (BL-416 precedent), so every
# worktree and the main checkout see the same counter regardless of which branch each has checked
# out. Deliberately NOT git-tracked (unlike BACKLOG.md itself): it is operational bookkeeping, not
# human-readable source of truth, and committing it would force an arbitrary branch to own writes
# that every worktree needs to make regardless of branch — the same reason `.bl-id.lock` above is
# untracked. Durability comes from living on the shared filesystem path, not from git history.
.bl-id-counter.json
# sox-memory temp test dirs (any .tmp-* scratch dir — never belongs in git)
.tmp-*/
# nx machine-local state (never belongs in git)
.nx/
# macOS junk
.DS_Store
# tsc incremental build cache
*.tsbuildinfo
# machine-local runtime / home state
.extensions/runtime.json
.extensions/extensions.json
.sox/
/data/
# project-local MCP config (contains absolute machine paths)
.mcp.json
# per-extension build/demo artifacts
extensions/services/tokenguard/bundle/
extensions/services/tokenguard/demo/out/
# BL-37/BL-38: self-contained esbuild bundles (build artifacts, never committed)
# (memory-daemon was deleted in S9/BL-162 — its bundle/ entry removed here per BL-168)
extensions/bundles/sox-memory-bundle/members/memory-server/bundle/
# soxe init test-scaffold output
/test-*-init/
# plan runtime event logs (append-only, machine-local)
.workflow/plans/*/events.ndjson
# baseline snapshot DBs (large, tracked by sha256 in JSON)
docs/plan/runtime-productionization/_shared/baselines/*.db
docs/plan/runtime-productionization/_shared/baselines/*.db-wal
docs/plan/runtime-productionization/_shared/baselines/*.db-shm

# git worktrees (house rule: always under .worktrees/)
.worktrees/

# project/local-scope sox data root (machine-local state, never committed)
.adhd/
